MONGO_URI=mongodb://localhost:27017/anonymous-voting
JWT_SECRET=replace_with_secure_random_secret
# Module 2: copy this template to the REPOSITORY ROOT .env (not backend/.env).
# Set the sender Gmail address and its valid Google App Password locally.
# Blank values deliberately disable email delivery; OTPs are never logged.
OTP_EMAIL=
OTP_EMAIL_PASSWORD=
RSA_PRIVATE_KEY_PATH=./keys/private.pem
RSA_PUBLIC_KEY_PATH=./keys/public.pem
# AES_SECRET_KEY must be exactly 64 hexadecimal characters (= 32 bytes when decoded).
# This is required for AES-256-GCM vote encryption. Do NOT use a plain 32-character string.
# Generate a safe value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AES_SECRET_KEY=replace_with_64_hex_character_secret
PORT=5000
